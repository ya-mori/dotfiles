{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "GITHUB_PERSONAL_ACCESS_TOKEN": "{{ keyring "github" .chezmoi.username }}"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      {{- range $i, $cmd := .permissions.bash_allow }}
      {{- if $i }},{{ end }}
      "Bash({{ $cmd }}:*)"
      {{- end }},
      "Edit(.ai_workspace/**)",
      "Edit({{ .chezmoi.homeDir }}/**/.ai_workspace/**)",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs"
    ],
    "deny": [
      "Read(~/.zshenv.local)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "{{ .chezmoi.homeDir }}/.ai_workspace/claude/session-logs"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Codeが許可を求めています\" with title \"Claude Code\" subtitle \"確認待ち\" sound name \"Funk\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"作業が完了しました。\" with title \"Claude Code\" sound name \"Glass\"'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-event.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "p=$(ls -t ~/.claude/plans/*.md 2>/dev/null | head -1); [ -n \"$p\" ] && code \"$p\"; exit 0",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Codeが質問しています\" with title \"Claude Code\" subtitle \"確認を待機中\" sound name \"Funk\"'",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": false,
    "superpowers@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "github@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "figma@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "context7@claude-plugins-official": true
  },
  "language": "Japanese",
  "tui": "fullscreen",
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
