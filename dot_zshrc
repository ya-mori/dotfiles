# Default
export PATH=$PATH:$HOME/.local/bin:$HOME/bin


# App Env

export ENV=loc
export VERTEX_ENV=loc
export SERVICE_ENV=loc


# Command Alias

alias kc=kubectl
alias gs=gsutil
alias kctx=kubectx
alias ll='ls -la'
alias morning!='hello.sh'
alias gsopen='gsopen.sh'


# Command Setup

## mise
[ -x "$HOME/.local/bin/mise" ] && eval "$($HOME/.local/bin/mise activate zsh)"

## direnv
command -v direnv >/dev/null && eval "$(direnv hook zsh)"

# マシン固有・ツール自動追記分は管理外ファイルへ
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
